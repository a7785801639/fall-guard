# === Обязательные параметры камеры и Telegram ===
# Необязательные реквизиты камеры для диагностики и шаблонов:
CAM_HOST=192.168.1.50
CAM_USER=admin
CAM_PASS=your_camera_password_here

# Примеры RTSP-ссылок по маркам камер:
#   Hikvision/HiWatch:  rtsp://admin:pass@192.168.1.50:554/Streaming/Channels/101   (или /102 субпоток)
#   TP-Link Tapo:       rtsp://user:pass@192.168.1.50:554/stream1   (или /stream2)
#   Dahua / Imou:       rtsp://admin:pass@192.168.1.50:554/cam/realmonitor?channel=1&subtype=0
RTSP_URL=your_rtsp_url_here

# Токен бота от @BotFather, username бота и список chat_id получателей через запятую (опционально при автоподписке /start)
TG_BOT_TOKEN=your_telegram_bot_token_here
TG_BOT_USERNAME=your_bot_username
TG_CHAT_IDS=
PUBLIC_WEBAPP_URL=https://nofall.example.com
TZ=UTC

# === Ориентация камеры и вытягивание теней (CLAHE) ===
# Угол поворота кадра: 0, 90, 180 (если камера установлена вверх ногами), 270
FRAME_ROTATE=180
FRAME_FLIP_H=false
LOW_LIGHT_ENHANCE=true

# === Параметры веб-пульта и инференса ===
WEB_PORT=8090
POSE_MODEL=yolo11s-pose.pt
DEVICE=auto
INFER_FPS=5.0
CAPTURE_FPS=6.0
POSE_CONF=0.35

# === Таймеры срабатывания и антидребезга (в секундах) ===
PRE_EVENT_SECONDS=5.0
POST_EVENT_SECONDS=4.0
INITIAL_BED_LOCK_SECONDS=5.0
BED_LOCK_SECONDS=20.0
SIT_CONFIRM_SECONDS=1.8
LEAVE_CONFIRM_SECONDS=2.0
FALL_CONFIRM_SECONDS=1.8
MISSING_CONFIRM_SECONDS=12.0
ALERT_COOLDOWN_SECONDS=45.0

# Повторный сигнал при неподтверждённом падении каждые N секунд
REPEAT_FALL_ALERT_SECONDS=15.0
MAX_FALL_REPEATS=20
SUPPRESS_SITTING_WHEN_CAREGIVER=true
FACE_MATCH_THRESHOLD=0.38
