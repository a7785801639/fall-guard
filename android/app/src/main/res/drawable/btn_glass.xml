<?xml version="1.0" encoding="utf-8"?>
<!-- Вторичные кнопки на красном фоне: полупрозрачное «стекло», а не серые плашки -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1FFFFFFF" />
            <stroke android:width="1dp" android:color="#29FFFFFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</ripple>
