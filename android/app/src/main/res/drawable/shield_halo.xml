<?xml version="1.0" encoding="utf-8"?>
<!-- Два тонких кольца вокруг щита -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <stroke android:width="1dp" android:color="#265BE0A1" />
        </shape>
    </item>
    <item android:bottom="12dp" android:left="12dp" android:right="12dp" android:top="12dp">
        <shape android:shape="oval">
            <solid android:color="#0F5BE0A1" />
            <stroke android:width="1dp" android:color="#405BE0A1" />
        </shape>
    </item>
</layer-list>
