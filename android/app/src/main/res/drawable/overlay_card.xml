<?xml version="1.0" encoding="utf-8"?>
<!-- Всплывающая тревога: тёмное «стекло» с красным свечением слева и тонкой красной кромкой -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#FF3B0D13" android:centerColor="#FF250A0E" android:endColor="#FF1A0A0D" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="radial" android:centerX="0.08" android:centerY="0.2" android:gradientRadius="60%p"
                android:startColor="#66E5383F" android:endColor="#00E5383F" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#59FF6B70" />
            <corners android:radius="26dp" />
        </shape>
    </item>
</layer-list>
