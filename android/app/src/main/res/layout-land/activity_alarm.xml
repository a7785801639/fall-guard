<?xml version="1.0" encoding="utf-8"?>
<!-- Горизонтальное положение: кадр слева, текст и кнопки справа (прокручиваются) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="horizontal"
    android:padding="16dp">

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.1"
        android:gravity="center">

        <ImageView
            android:id="@+id/alarmImage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:adjustViewBounds="true"
            android:background="@drawable/frame_round"
            android:contentDescription="Кадр с камеры"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/alarmLive"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:layout_gravity="top|start"
            android:layout_margin="10dp"
            android:background="@drawable/chip_live"
            android:drawablePadding="6dp"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="● Снимок"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </FrameLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:clipChildren="false">

                    <View
                        android:id="@+id/alarmRing1"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:alpha="0"
                        android:background="@drawable/alarm_ring" />

                    <View
                        android:id="@+id/alarmRing2"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:alpha="0"
                        android:background="@drawable/alarm_ring" />

                    <TextView
                        android:id="@+id/alarmBadge"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/alarm_badge"
                        android:gravity="center"
                        android:text="!"
                        android:textColor="@color/alarm"
                        android:textSize="24sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <TextView
                    android:id="@+id/alarmTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:textColor="@color/alarm_eyebrow"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/alarmTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/text"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/alarmDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingMultiplier="1.1"
                android:textColor="@color/alarm_soft"
                android:textSize="15sp" />

            <!-- Низкий экран: время и подпись в одну строку -->
            <LinearLayout
                android:id="@+id/alarmTimerBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/alarmElapsed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:includeFontPadding="false"
                    android:text="0:00"
                    android:textColor="@color/text"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/alarmElapsedLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/alarm_elapsed_label"
                    android:textColor="@color/alarm_soft"
                    android:textSize="14sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnAck"
                style="@style/Btn.Danger"
                android:text="Принято, иду" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnFalse"
                    style="@style/Btn"
                    android:layout_width="0dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:text="Ложная тревога" />

                <Button
                    android:id="@+id/btnOpen"
                    style="@style/Btn"
                    android:layout_width="0dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:text="Смотреть камеру" />
            </LinearLayout>

            <Button
                android:id="@+id/btnSilence"
                style="@style/Btn"
                android:background="@android:color/transparent"
                android:text="Только выключить звук на этом телефоне"
                android:textColor="@color/alarm_soft"
                android:textSize="14sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
