<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.Theme.FallGuard" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:colorAccent">@color/calm</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:colorControlActivated">@color/calm</item>
        <item name="android:fontFamily">@font/onest</item>
    </style>

    <style name="Theme.FallGuard" parent="Base.Theme.FallGuard" />

    <style name="Theme.FallGuard.Alarm">
        <item name="android:windowBackground">@color/alarm_bg</item>
        <item name="android:statusBarColor">@color/alarm_bg</item>
        <item name="android:navigationBarColor">@color/alarm_bg</item>
    </style>

    <style name="Btn">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:background">@drawable/btn_surface</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Btn.Primary">
        <item name="android:background">@drawable/btn_primary</item>
        <item name="android:textColor">@color/on_calm</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Btn.Danger">
        <item name="android:background">@drawable/btn_danger</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_height">72dp</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="Btn.Danger.Small">
        <item name="android:layout_height">52dp</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Section">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">28dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="Label">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Field">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:background">@drawable/btn_surface</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textColorHint">@color/muted</item>
        <item name="android:textSize">16sp</item>
        <item name="android:singleLine">true</item>
    </style>
</resources>
