<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Свечение сверху «дышит» вместе с сиреной -->
    <View
        android:id="@+id/alarmGlow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/alarm_glow" />

    <LinearLayout
        android:id="@+id/alarmContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <!-- Без прокрутки. Сверху крупно кадр с камеры (целиком, в пропорциях камеры),
             под ним по центру свободного места — пульсирующий значок события и заголовок,
             внизу кнопки. На низком экране кадр уменьшается, значок прячется. -->
        <app.fallguard.FitBox
            android:id="@+id/alarmFrame"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false">

            <FrameLayout
                android:id="@+id/alarmFrameCard"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/frame_round"
                android:foreground="@drawable/frame_border">

                <ImageView
                    android:id="@+id/alarmImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Кадр с камеры"
                    android:scaleType="centerCrop" />

                <!-- «Эфир» — живое видео; касание переключает на снимок момента тревоги -->
                <TextView
                    android:id="@+id/alarmLive"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_gravity="top|start"
                    android:layout_margin="10dp"
                    android:background="@drawable/chip_live"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="● Снимок"
                    android:textColor="#FFFFFF"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <!-- Сколько без ответа: кольцо обегает круг за минуту -->
                <LinearLayout
                    android:id="@+id/alarmTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="10dp"
                    android:background="@drawable/chip_live"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="4dp"
                    android:paddingEnd="12dp">

                    <app.fallguard.ElapsedRing
                        android:id="@+id/alarmRing"
                        android:layout_width="26dp"
                        android:layout_height="26dp" />

                    <TextView
                        android:id="@+id/alarmElapsed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFeatureSettings="tnum"
                        android:includeFontPadding="false"
                        android:text="0:00"
                        android:textColor="@color/text"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:id="@+id/alarmHero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="18dp"
                android:paddingBottom="6dp">

                <FrameLayout
                    android:id="@+id/alarmBadgeWrap"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_marginBottom="18dp"
                    android:clipChildren="false">

                    <View
                        android:id="@+id/alarmRing1"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:alpha="0"
                        android:background="@drawable/alarm_ring" />

                    <View
                        android:id="@+id/alarmRing2"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:alpha="0"
                        android:background="@drawable/alarm_ring" />

                    <!-- Значок типа события: падение, встала, зовёт рукой… -->
                    <FrameLayout
                        android:id="@+id/alarmBadge"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/alarm_badge"
                        android:elevation="6dp">

                        <ImageView
                            android:id="@+id/alarmIcon"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@null"
                            android:padding="15dp"
                            android:src="@drawable/ic_k_fall" />
                    </FrameLayout>
                </FrameLayout>

                <TextView
                    android:id="@+id/alarmTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:gravity="center"
                    android:letterSpacing="0.12"
                    android:textColor="@color/alarm_eyebrow"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/alarmTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:breakStrategy="balanced"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:letterSpacing="-0.01"
                    android:lineSpacingMultiplier="0.95"
                    android:maxLines="3"
                    android:textColor="@color/text"
                    android:textSize="@dimen/alarm_title"
                    android:textStyle="bold" />
            </LinearLayout>
        </app.fallguard.FitBox>

            <!-- Главная кнопка: по ней раз в несколько секунд пробегает блик -->
            <FrameLayout
                android:id="@+id/ackWrap"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="10dp">

                <Button
                    android:id="@+id/btnAck"
                    style="@style/Btn.Danger"
                    android:layout_height="match_parent"
                    android:layout_marginTop="0dp"
                    android:text="Принято, иду" />

                <View
                    android:id="@+id/ackShine"
                    android:layout_width="96dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/ack_shine"
                    android:translationX="-120dp" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnFalse"
                    style="@style/Btn"
                    android:background="@drawable/btn_glass"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:layout_width="0dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:text="Ложная тревога" />

                <Button
                    android:id="@+id/btnOpen"
                    style="@style/Btn"
                    android:background="@drawable/btn_glass"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:layout_width="0dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:text="Смотреть камеру" />
            </LinearLayout>

            <Button
                android:id="@+id/btnSilence"
                style="@style/Btn"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:background="@android:color/transparent"
                android:text="Только выключить звук на этом телефоне"
                android:textColor="@color/alarm_soft"
                android:textSize="14sp" />
    </LinearLayout>

    <!-- Подтверждение после нажатия: раскрывается кругом от кнопки -->
    <LinearLayout
        android:id="@+id/alarmDone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0F2A1F"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/doneCircle"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:background="@drawable/done_circle_calm">

            <ImageView
                android:id="@+id/doneIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:padding="24dp"
                android:src="@drawable/ic_done_check" />
        </FrameLayout>

        <TextView
            android:id="@+id/doneTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Принято"
            android:textColor="@color/text"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/doneSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textColor="@color/muted"
            android:textSize="16sp" />
    </LinearLayout>
</FrameLayout>
