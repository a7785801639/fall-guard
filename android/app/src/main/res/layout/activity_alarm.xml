<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Свечение сверху «дышит» вместе с сиреной -->
    <View
        android:id="@+id/alarmGlow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/alarm_glow" />

    <LinearLayout
        android:id="@+id/alarmContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Без прокрутки: шапка и текст сверху, кадр занимает всё свободное место, кнопки внизу видны всегда -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:clipChildren="false">

                <View
                    android:id="@+id/alarmRing1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:alpha="0"
                    android:background="@drawable/alarm_ring" />

                <View
                    android:id="@+id/alarmRing2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:alpha="0"
                    android:background="@drawable/alarm_ring" />

                <!-- Значок типа события: падение, встала, зовёт рукой… -->
                <FrameLayout
                    android:id="@+id/alarmBadge"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/alarm_badge">

                    <ImageView
                        android:id="@+id/alarmIcon"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:padding="10dp"
                        android:src="@drawable/ic_k_fall" />
                </FrameLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/alarmTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:fontFeatureSettings="tnum"
                android:letterSpacing="0.06"
                android:lineSpacingMultiplier="1.05"
                android:maxLines="2"
                android:textColor="@color/alarm_eyebrow"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Секундомер «без ответа»: цифры и кольцо, которое обегает круг за минуту -->
            <LinearLayout
                android:id="@+id/alarmTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/timer_chip"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingTop="4dp"
                android:paddingEnd="14dp"
                android:paddingBottom="4dp">

                <app.fallguard.ElapsedRing
                    android:id="@+id/alarmRing"
                    android:layout_width="38dp"
                    android:layout_height="38dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/alarmElapsed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:includeFontPadding="false"
                        android:text="0:00"
                        android:textColor="@color/text"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/alarmElapsedLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:includeFontPadding="false"
                        android:text="без ответа"
                        android:textColor="@color/alarm_soft"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/alarmTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:ellipsize="end"
            android:letterSpacing="-0.01"
            android:lineSpacingMultiplier="0.95"
            android:maxLines="3"
            android:textColor="@color/text"
            android:textSize="@dimen/alarm_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/alarmDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:lineSpacingMultiplier="1.1"
            android:maxLines="3"
            android:textColor="@color/alarm_soft"
            android:textSize="@dimen/alarm_desc" />

        <!-- Кадр вписан в свободное место целиком, в пропорциях камеры; плашка «Эфир» — на самом кадре -->
        <app.fallguard.FitBox
            android:id="@+id/alarmFrame"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="6dp"
            android:layout_weight="1"
            app:alignTop="true">

            <FrameLayout
                android:id="@+id/alarmFrameCard"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/frame_round"
                android:foreground="@drawable/frame_border">

                <ImageView
                    android:id="@+id/alarmImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Кадр с камеры"
                    android:scaleType="centerCrop" />

                <!-- «Эфир» — живое видео; касание переключает на снимок момента тревоги -->
                <TextView
                    android:id="@+id/alarmLive"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:layout_gravity="top|start"
                    android:layout_margin="10dp"
                    android:background="@drawable/chip_live"
                    android:gravity="center_vertical"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="● Снимок"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </app.fallguard.FitBox>

            <!-- Главная кнопка: по ней раз в несколько секунд пробегает блик -->
            <FrameLayout
                android:id="@+id/ackWrap"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="10dp">

                <Button
                    android:id="@+id/btnAck"
                    style="@style/Btn.Danger"
                    android:layout_height="match_parent"
                    android:layout_marginTop="0dp"
                    android:text="Принято, иду" />

                <View
                    android:id="@+id/ackShine"
                    android:layout_width="96dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/ack_shine"
                    android:translationX="-120dp" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnFalse"
                    style="@style/Btn"
                    android:background="@drawable/btn_glass"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:layout_width="0dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:text="Ложная тревога" />

                <Button
                    android:id="@+id/btnOpen"
                    style="@style/Btn"
                    android:background="@drawable/btn_glass"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:layout_width="0dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:text="Смотреть камеру" />
            </LinearLayout>

            <Button
                android:id="@+id/btnSilence"
                style="@style/Btn"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:background="@android:color/transparent"
                android:text="Только выключить звук на этом телефоне"
                android:textColor="@color/alarm_soft"
                android:textSize="14sp" />
    </LinearLayout>

    <!-- Подтверждение после нажатия: раскрывается кругом от кнопки -->
    <LinearLayout
        android:id="@+id/alarmDone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0F2A1F"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/doneCircle"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:background="@drawable/done_circle_calm">

            <ImageView
                android:id="@+id/doneIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:padding="24dp"
                android:src="@drawable/ic_done_check" />
        </FrameLayout>

        <TextView
            android:id="@+id/doneTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Принято"
            android:textColor="@color/text"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/doneSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textColor="@color/muted"
            android:textSize="16sp" />
    </LinearLayout>
</FrameLayout>
