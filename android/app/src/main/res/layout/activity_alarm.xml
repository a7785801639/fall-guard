<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/alarm_badge"
            android:gravity="center"
            android:text="!"
            android:textColor="@color/alarm"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/alarmTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textColor="#FFB4B6"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/alarmTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:textColor="#FFFFFF"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/alarmDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#F3D6D7"
        android:textSize="17sp" />

    <!-- Кадр сразу под текстом, во всю ширину, со скруглением -->
    <ImageView
        android:id="@+id/alarmImage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:adjustViewBounds="true"
        android:background="@drawable/frame_round"
        android:clipToOutline="true"
        android:contentDescription="Кадр с камеры"
        android:maxHeight="360dp"
        android:minHeight="160dp"
        android:scaleType="fitCenter" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/btnAck"
        style="@style/Btn.Danger"
        android:text="Принято, иду" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnFalse"
            style="@style/Btn"
            android:layout_width="0dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:text="Ложная тревога" />

        <Button
            android:id="@+id/btnOpen"
            style="@style/Btn"
            android:layout_width="0dp"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:text="Смотреть камеру" />
    </LinearLayout>

    <Button
        android:id="@+id/btnSilence"
        style="@style/Btn"
        android:background="@android:color/transparent"
        android:text="Только выключить звук на этом телефоне"
        android:textColor="#F3D6D7"
        android:textSize="14sp" />
</LinearLayout>
