<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Знак тревоги с расходящимися кольцами -->
        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:clipChildren="false">

            <View
                android:id="@+id/alarmRing1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0"
                android:background="@drawable/alarm_ring" />

            <View
                android:id="@+id/alarmRing2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0"
                android:background="@drawable/alarm_ring" />

            <TextView
                android:id="@+id/alarmBadge"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/alarm_badge"
                android:gravity="center"
                android:text="!"
                android:textColor="@color/alarm"
                android:textSize="26sp"
                android:textStyle="bold" />
        </FrameLayout>

        <TextView
            android:id="@+id/alarmTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textColor="@color/alarm_eyebrow"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/alarmTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:textColor="@color/text"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/alarmDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:lineSpacingMultiplier="1.1"
        android:textColor="@color/alarm_soft"
        android:textSize="17sp" />

    <!-- Кадр сразу под текстом, во всю ширину, со скруглением -->
    <ImageView
        android:id="@+id/alarmImage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:adjustViewBounds="true"
        android:background="@drawable/frame_round"
        android:contentDescription="Кадр с камеры"
        android:maxHeight="360dp"
        android:minHeight="160dp"
        android:scaleType="fitCenter" />

    <!-- Сколько тревога висит без ответа: заполняет свободное место на высоких экранах,
         на низких прячется, чтобы не сдвигать кнопки -->
    <LinearLayout
        android:id="@+id/alarmTimerBox"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/alarmElapsed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:includeFontPadding="false"
            android:text="0:00"
            android:textColor="@color/text"
            android:textSize="60sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/alarmElapsedLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/alarm_elapsed_label"
            android:textColor="@color/alarm_soft"
            android:textSize="15sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnAck"
        style="@style/Btn.Danger"
        android:text="Принято, иду" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnFalse"
            style="@style/Btn"
            android:layout_width="0dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:text="Ложная тревога" />

        <Button
            android:id="@+id/btnOpen"
            style="@style/Btn"
            android:layout_width="0dp"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:text="Смотреть камеру" />
    </LinearLayout>

    <Button
        android:id="@+id/btnSilence"
        style="@style/Btn"
        android:background="@android:color/transparent"
        android:text="Только выключить звук на этом телефоне"
        android:textColor="@color/alarm_soft"
        android:textSize="14sp" />
</LinearLayout>
