<?xml version="1.0" encoding="utf-8"?>
<!-- Мини-тревога поверх всех приложений: карточка и свёрнутая «пилюля» -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ovRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingBottom="18dp">

    <LinearLayout
        android:id="@+id/ovCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/overlay_card"
        android:elevation="14dp"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Кадр с камеры, в углу — значок события -->
            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:clipChildren="false">

                <View
                    android:id="@+id/ovRing"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:alpha="0"
                    android:background="@drawable/alarm_ring" />

                <ImageView
                    android:id="@+id/ovThumb"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/thumb_round"
                    android:contentDescription="Кадр с камеры"
                    android:scaleType="centerCrop" />

                <ImageView
                    android:id="@+id/ovKind"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="-6dp"
                    android:layout_marginBottom="-6dp"
                    android:background="@drawable/badge_red"
                    android:contentDescription="@null"
                    android:padding="5dp"
                    android:src="@drawable/ic_k_fall"
                    android:tint="#FFFFFF" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/ovEyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:letterSpacing="0.08"
                    android:text="ТРЕВОГА · 0:00"
                    android:textColor="@color/alarm_eyebrow"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/ovTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/ovSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/alarm_soft"
                    android:textSize="13.5sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ovActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/ovAck"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="5dp"
                android:layout_weight="1.35"
                android:background="@drawable/pill_primary"
                android:stateListAnimator="@null"
                android:text="Принято, иду"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15.5sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/ovOpen"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="@drawable/pill_glass"
                android:stateListAnimator="@null"
                android:text="Смотреть"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Ручка: смахните вверх, чтобы свернуть -->
        <View
            android:id="@+id/ovGrip"
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="-4dp"
            android:alpha="0.28"
            android:background="@drawable/grip" />
    </LinearLayout>

    <!-- Свёрнутая тревога -->
    <LinearLayout
        android:id="@+id/ovPill"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/overlay_pill"
        android:elevation="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="16dp"
        android:visibility="gone">

        <View
            android:id="@+id/ovPillDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/dot_red" />

        <TextView
            android:id="@+id/ovPillText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFeatureSettings="tnum"
            android:text="Тревога · 0:00"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
