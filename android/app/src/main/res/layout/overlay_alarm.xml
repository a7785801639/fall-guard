<?xml version="1.0" encoding="utf-8"?>
<!-- Мини-тревога поверх всех приложений: карточка и свёрнутая «пилюля» -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ovRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="28dp">

    <!-- Как входящий вызов: сверху кадр со значком события и текст во всю ширину,
         снизу — время без ответа и две круглые кнопки. Подписей на кнопках нет — обрезаться нечему,
         текст переносится, а не ужимается. -->
    <LinearLayout
        android:id="@+id/ovCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/overlay_card"
        android:clipChildren="false"
        android:elevation="14dp"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="14dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:orientation="horizontal">

            <!-- Кадр с камеры в круге, в углу — значок события -->
            <FrameLayout
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:clipChildren="false">

                <View
                    android:id="@+id/ovRing"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:alpha="0"
                    android:background="@drawable/alarm_ring" />

                <ImageView
                    android:id="@+id/ovThumb"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/thumb_circle"
                    android:contentDescription="Кадр с камеры"
                    android:foreground="@drawable/thumb_circle_border"
                    android:scaleType="centerCrop" />

                <ImageView
                    android:id="@+id/ovKind"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="-4dp"
                    android:layout_marginBottom="-4dp"
                    android:background="@drawable/badge_red"
                    android:contentDescription="@null"
                    android:padding="5dp"
                    android:src="@drawable/ic_k_fall"
                    android:tint="#FFFFFF" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/ovTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:lineSpacingMultiplier="0.98"
                    android:maxLines="3"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/ovSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="3"
                    android:textColor="@color/alarm_soft"
                    android:textSize="13.5sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Сколько тревога без ответа -->
            <View
                android:id="@+id/ovDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="2dp"
                android:background="@drawable/dot_red"
                android:backgroundTint="#FF6B70" />

            <TextView
                android:id="@+id/ovEyebrow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:fontFeatureSettings="tnum"
                android:letterSpacing="0.08"
                android:text="ТРЕВОГА · 0:00"
                android:textColor="@color/alarm_eyebrow"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/ovActions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/ovOpen"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/round_glass"
                    android:contentDescription="Смотреть камеру"
                    android:padding="13dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_b_eye"
                    android:tint="#FFFFFF"
                    android:tooltipText="Смотреть камеру" />

                <ImageButton
                    android:id="@+id/ovAck"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/round_ack"
                    android:contentDescription="Принято, иду"
                    android:minWidth="72dp"
                    android:paddingStart="24dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="24dp"
                    android:paddingBottom="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_b_check"
                    android:tint="@color/on_calm"
                    android:tooltipText="Принято, иду" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Свёрнутая тревога -->
    <LinearLayout
        android:id="@+id/ovPill"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/overlay_pill"
        android:elevation="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="16dp"
        android:visibility="gone">

        <View
            android:id="@+id/ovPillDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/dot_red" />

        <TextView
            android:id="@+id/ovPillText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFeatureSettings="tnum"
            android:text="Тревога · 0:00"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
