<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="-10dp"
            android:background="@drawable/btn_round"
            android:contentDescription="Назад"
            android:rotation="180"
            android:scaleType="center"
            android:src="@drawable/ic_chev"
            android:tint="@color/text" />

        <TextView
            android:id="@+id/setTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Настройки приложения"
            android:textColor="@color/text"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/setInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingMultiplier="1.15"
            android:textColor="@color/muted"
            android:textSize="15sp" />

        <!-- Готовность к тревоге одним взглядом: три деления — уведомления, фон, окно поверх блокировки -->
        <LinearLayout
            android:id="@+id/readyBar"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <View android:id="@+id/readySeg1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/seg_off" />
            <View android:id="@+id/readySeg2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="5dp" android:layout_weight="1" android:background="@drawable/seg_off" />
            <View android:id="@+id/readySeg3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="5dp" android:layout_weight="1" android:background="@drawable/seg_off" />
        </LinearLayout>

        <TextView
            android:id="@+id/readyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <!-- Доступное обновление (только у сборок с автообновлением) -->
        <LinearLayout
            android:id="@+id/updateBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/card_ripple"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/updateTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/updateSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Установится поверх, настройки сохранятся"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnUpdate"
                style="@style/Btn.Primary"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginTop="0dp"
                android:layout_marginStart="10dp"
                android:minHeight="0dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Установить"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            style="@style/Section"
            android:text="Тревога точно дойдёт" />

        <LinearLayout
            android:id="@+id/checklist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/btnTest"
            style="@style/Btn.Primary"
            android:layout_marginTop="14dp"
            android:text="Проверить тревогу сейчас" />

        <Button
            android:id="@+id/btnDone"
            style="@style/Btn"
            android:text="Готово"
            android:visibility="gone" />

        <TextView
            style="@style/Section"
            android:text="Как сигналить" />

        <LinearLayout
            android:id="@+id/signalList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            style="@style/Section"
            android:text="Адреса сервера" />

        <TextView
            style="@style/Label"
            android:layout_marginTop="6dp"
            android:text="Дома" />

        <EditText
            android:id="@+id/setLan"
            style="@style/Field"
            android:hint="например 192.168.1.50:8090"
            android:importantForAutofill="no"
            android:inputType="textUri" />

        <TextView
            style="@style/Label"
            android:layout_marginTop="12dp"
            android:text="Вне дома" />

        <EditText
            android:id="@+id/setPublic"
            style="@style/Field"
            android:hint="https://…"
            android:importantForAutofill="no"
            android:inputType="textUri" />

        <Button
            android:id="@+id/btnSaveUrls"
            style="@style/Btn"
            android:text="Сохранить адреса" />

        <!-- Опасное действие — отдельно, внизу, без плашки; подтверждается диалогом -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="40dp"
            android:background="@color/line" />

        <Button
            android:id="@+id/btnUnpair"
            style="@style/Btn"
            android:layout_marginTop="12dp"
            android:background="@android:color/transparent"
            android:text="Отвязать этот телефон"
            android:textColor="@color/alarm" />

        <Button
            android:id="@+id/btnCheckUpdate"
            style="@style/Btn"
            android:layout_marginTop="16dp"
            android:background="@android:color/transparent"
            android:text="Проверить обновления"
            android:textColor="@color/muted"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/setVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textColor="@color/muted"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
