<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Настройки приложения"
            android:textColor="@color/text"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/setInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingMultiplier="1.15"
            android:textColor="@color/muted"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Чтобы тревога точно дошла"
            android:textColor="@color/text"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnTest"
            style="@style/Btn.Primary"
            android:text="Проверить тревогу сейчас" />

        <Button
            android:id="@+id/btnBattery"
            style="@style/Btn"
            android:text="Разрешить работу в фоне (батарея)" />

        <Button
            android:id="@+id/btnNotif"
            style="@style/Btn"
            android:text="Настройки уведомлений" />

        <Button
            android:id="@+id/btnFullScreen"
            style="@style/Btn"
            android:text="Разрешить окно на весь экран" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Адреса сервера"
            android:textColor="@color/text"
            android:textSize="17sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/setLan"
            style="@style/Field"
            android:hint="Дома: 192.168.1.50:8090"
            android:importantForAutofill="no"
            android:inputType="textUri" />

        <EditText
            android:id="@+id/setPublic"
            style="@style/Field"
            android:hint="Вне дома: https://…"
            android:importantForAutofill="no"
            android:inputType="textUri" />

        <Button
            android:id="@+id/btnSaveUrls"
            style="@style/Btn"
            android:text="Сохранить адреса" />

        <Button
            android:id="@+id/btnUnpair"
            style="@style/Btn"
            android:layout_marginTop="32dp"
            android:text="Отвязать этот телефон"
            android:textColor="@color/alarm" />
    </LinearLayout>
</ScrollView>
